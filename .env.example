# ---------------------------------------------------------------------------
# Configuración del frontend Huecko
# Referencia de variables. Cada modo ya trae las suyas en `.env.development`,
# `.env.production` y `.env.demo`; para ajustes locales usa `.env.development.local`.
# ---------------------------------------------------------------------------

# URL base del backend Spring Boot, incluyendo el prefijo de API.
#
#   vacía  → MODO DEMO: la app funciona sola con datos simulados
#            (usuario alex.rodriguez@huecko.com / demo1234).
#   /api   → MODO CONECTADO en desarrollo: pasa por el proxy de Vite,
#            que reenvía a VITE_BACKEND_PROXY. No requiere CORS.
#   https://…/api → MODO CONECTADO en despliegue (requiere CORS en el backend).
VITE_API_URL=

# Destino del proxy de desarrollo. Solo se usa cuando VITE_API_URL=/api.
VITE_BACKEND_PROXY=http://localhost:8080
