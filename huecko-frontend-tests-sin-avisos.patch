From c47a0492a071a5235b5aaadea2614881abf551c2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 15 Sep 2026 21:13:28 +0000
Subject: [PATCH] test: quitar los avisos de persist en las pruebas de stores
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

persist de zustand busca window.localStorage y en el entorno node no hay
window, así que cada cambio de estado imprimía «storage is currently
unavailable». El almacenamiento en memoria ahora también define window.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JDoAwT6P4ywvwkW8xr6yW3
---
 src/test/almacenamientoEnMemoria.ts | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/test/almacenamientoEnMemoria.ts b/src/test/almacenamientoEnMemoria.ts
index dc2e719..c0107ce 100644
--- a/src/test/almacenamientoEnMemoria.ts
+++ b/src/test/almacenamientoEnMemoria.ts
@@ -26,4 +26,15 @@ export function instalarAlmacenamientoEnMemoria(): void {
     configurable: true,
     writable: true,
   });
+
+  /* `persist` de zustand busca `window.localStorage`, no `localStorage` a
+     secas. En `node` no hay `window` y el store avisaba en cada cambio de que
+     el almacenamiento no estaba disponible. */
+  if (typeof window === 'undefined') {
+    Object.defineProperty(globalThis, 'window', {
+      value: globalThis,
+      configurable: true,
+      writable: true,
+    });
+  }
 }
-- 
